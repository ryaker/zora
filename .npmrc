# Dependency release-age gate (#217): refuse package versions published less
# than 3 days ago, so a freshly hijacked release cannot land via a developer
# `npm install`. Honored by npm >= 11.x; older npm (e.g. the one bundled with
# Node 20) ignores unknown keys, so this is defense in depth, not the only
# control. CI keeps `npm ci --ignore-scripts` against the committed lockfile.
min-release-age=3
